# Configurações SSH para Servidor DayZ
# Copie este arquivo para .env e preencha com suas credenciais
# NÃO commite o arquivo .env no repositório!

# Host do servidor DayZ
DAYZ_SSH_HOST=192.168.1.100

# Porta SSH (padrão: 22)
DAYZ_SSH_PORT=22

# Usuário SSH
DAYZ_SSH_USER=dayzadmin

# Caminho para chave SSH privada (recomendado)
# Deixe vazio se usar senha
DAYZ_SSH_KEY_PATH=/home/dayzadmin/.ssh/id_rsa

# Senha SSH (use apenas se não usar KeyPath)
# Deixe vazio se usar chave SSH
DAYZ_SSH_PASSWORD=

# Caminhos dos arquivos no servidor DayZ
DAYZ_SSH_COMMANDS_FILE=/home/dayzadmin/servers/dayz-server/mpmissions/dayzOffline.chernarusplus/admin/files/commands_to_execute.txt
DAYZ_SSH_RESULTS_FILE=/home/dayzadmin/servers/dayz-server/mpmissions/dayzOffline.chernarusplus/admin/files/commands_results.txt

# Configurações opcionais (podem ser definidas no config.json)
# DAYZ_SSH_TIMEOUT=5
# DAYZ_SSH_POOL_SIZE=3
# DAYZ_SSH_CONNECTION_TTL=30
